APP_NAME=Movexa
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://movexa.lan:8088
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=movexa
DB_USERNAME=movexa
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=10080
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=movexa
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Browsers AND PHP reach Reverb through nginx on the single public port 8088 (wss://movexa.lan:8088/app/...).
# The Reverb server itself only listens on 127.0.0.1:8080.
REVERB_HOST=movexa.lan
REVERB_PORT=8088
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Only if the mkcert root CA is not installed system-wide:
REVERB_CA_BUNDLE=
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MOVEXA_DATA_ROOT=/www/data/movexa
MOVEXA_SERVE_MODE=xaccel
MOVEXA_SANDBOX=systemd
MOVEXA_SCANNER=clamd
MOVEXA_REQUIRE_SCANNER=true
CLAMD_SOCKET=/var/run/clamav/clamd.ctl
MOVEXA_QUARANTINE_DAYS=30
MOVEXA_HWACCEL=auto
MOVEXA_MAX_TRANSCODES=2
MOVEXA_CACHE_MAX_GB=200
MOVEXA_STREAMS_PER_USER=3
# Offline downloads: validity of a saved copy (renewed whenever the device reconnects)
MOVEXA_DOWNLOAD_TTL_DAYS=30
# Top 10 window and "وين وقفنا؟" recap threshold
MOVEXA_TOP10_DAYS=30
MOVEXA_RECAP_AFTER_DAYS=14
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe

# Optional: TMDB (needs internet). Leave empty for fully offline/manual metadata.
TMDB_API_KEY=

# HomeCore SSO (OIDC + PKCE) and dashboard API
HOMECORE_URL=https://homecore.lan
HOMECORE_OIDC_ENABLED=false
HOMECORE_OIDC_CLIENT_ID=
HOMECORE_OIDC_CLIENT_SECRET=
# Register exactly this redirect URI in HomeCore (port included):
HOMECORE_OIDC_REDIRECT=https://movexa.lan:8088/auth/homecore/callback
HOMECORE_THEME_CSS=

# CloudSync integration
CLOUDSYNC_URL=https://cloudsync.lan
CLOUDSYNC_TOKEN=
CLOUDSYNC_ROOT=/www/data/cloudsync
